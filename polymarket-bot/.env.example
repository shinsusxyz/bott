# Polymarket Low Odds Alert Bot Configuration

# Telegram Configuration (Required)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Chat ID to send alerts to (can be user ID or channel ID)
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Scanning Configuration (Optional)
# How often to scan for new opportunities (seconds)
SCAN_INTERVAL_SECONDS=10
# Price threshold for alerts (0.001 = 0.1%)
PRICE_THRESHOLD=0.001
# Minutes to wait before re-alerting same market
ALERT_COOLDOWN_MINUTES=60
