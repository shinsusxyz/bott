# Polymarket Smart Alert Bot Configuration

# ===== REQUIRED =====

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (for admin features)
# Get it from @userinfobot
TELEGRAM_ADMIN_ID=your_user_id_here

# ===== DEFAULTS (users can change via /settings) =====

# Price threshold for low odds alerts (0.01 = 1%)
DEFAULT_PRICE_THRESHOLD=0.01

# Minimum 24h volume for quality filter
DEFAULT_MIN_VOLUME=1000

# Minimum liquidity for quality filter
DEFAULT_MIN_LIQUIDITY=5000

# Maximum spread for quality filter (0.03 = 3%)
DEFAULT_MAX_SPREAD=0.03

# Scan interval in seconds
DEFAULT_SCAN_INTERVAL=60

# Minimum USD amount for whale alerts
DEFAULT_WHALE_THRESHOLD=30

# Alert cooldown in minutes
DEFAULT_ALERT_COOLDOWN=60

# ===== DIGEST =====

# Enable daily digest
DIGEST_ENABLED=false

# Digest time in UTC (HH:MM)
DIGEST_TIME_UTC=09:00

# ===== SYSTEM =====

# Database path
DATABASE_PATH=./data/bot.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Health check port
HEALTH_PORT=8080
